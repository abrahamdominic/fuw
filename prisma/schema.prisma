generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum Role { STUDENT ADMIN LIBRARIAN SUPER_ADMIN LECTURER }
enum MaterialType { LECTURE_NOTE TEXTBOOK PAST_QUESTION HANDOUT RESEARCH_PAPER JOURNAL PROJECT TUTORIAL OTHER }
model User { id String @id @default(cuid()); fullName String; matricNumber String? @unique; email String @unique; passwordHash String; role Role @default(STUDENT); facultyId String?; departmentId String?; level String?; isVerified Boolean @default(false); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; faculty Faculty? @relation(fields:[facultyId],references:[id]); department Department? @relation(fields:[departmentId],references:[id]); materials Material[] @relation("UploadedBy"); bookmarks Bookmark[]; downloads Download[]; views View[]; refreshTokens RefreshToken[]; auditLogs AuditLog[] }
model Faculty { id String @id @default(cuid()); name String @unique; slug String @unique; description String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; departments Department[]; users User[]; materials Material[] }
model Department { id String @id @default(cuid()); name String; slug String @unique; facultyId String; description String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; faculty Faculty @relation(fields:[facultyId],references:[id],onDelete:Cascade); courses Course[]; users User[]; materials Material[]; @@unique([name,facultyId]); @@index([facultyId]) }
model Course { id String @id @default(cuid()); code String @unique; name String; departmentId String; level String; description String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; department Department @relation(fields:[departmentId],references:[id],onDelete:Cascade); materials Material[]; @@index([departmentId,level]) }
model Material { id String @id @default(cuid()); title String; slug String @unique; description String; fileUrl String; fileName String; fileSize Int; mimeType String; materialType MaterialType; courseId String?; facultyId String; departmentId String; level String; academicSession String; uploadedById String; views Int @default(0); downloads Int @default(0); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; course Course? @relation(fields:[courseId],references:[id],onDelete:SetNull); faculty Faculty @relation(fields:[facultyId],references:[id]); department Department @relation(fields:[departmentId],references:[id]); uploadedBy User @relation("UploadedBy",fields:[uploadedById],references:[id]); bookmarks Bookmark[]; downloadRecords Download[]; viewRecords View[]; @@index([facultyId,departmentId,level]); @@index([createdAt]); @@index([materialType]) }
model Bookmark { id String @id @default(cuid()); userId String; materialId String; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); material Material @relation(fields:[materialId],references:[id],onDelete:Cascade); @@unique([userId,materialId]) }
model Download { id String @id @default(cuid()); userId String; materialId String; downloadedAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); material Material @relation(fields:[materialId],references:[id],onDelete:Cascade); @@index([materialId]) }
model View { id String @id @default(cuid()); userId String?; materialId String; viewedAt DateTime @default(now()); user User? @relation(fields:[userId],references:[id],onDelete:SetNull); material Material @relation(fields:[materialId],references:[id],onDelete:Cascade); @@index([materialId]) }
model RefreshToken { id String @id @default(cuid()); tokenHash String @unique; userId String; expiresAt DateTime; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId]) }
model AcademicSession { id String @id @default(cuid()); name String @unique; isActive Boolean @default(false); createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()); userId String?; action String; entity String; entityId String?; metadata Json?; createdAt DateTime @default(now()); user User? @relation(fields:[userId],references:[id],onDelete:SetNull); @@index([entity,createdAt]) }
